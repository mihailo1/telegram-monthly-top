# BotFather
BOT_TOKEN=

# Your Telegram user id (admin)
ADMIN_ID=

# Target channel
GROUP_CHAT_ID=-100xxxxxxxxxx
CHANNEL_USERNAME=krasiviyded

# Ranking
APP_TZ=Europe/Moscow
TOP_BASE=5
TOP_MAX=10

# User MTProto (https://my.telegram.org/apps)
API_ID=
API_HASH=
# After: npm run login  → paste data/user.session here for Vercel
STRING_SESSION=
SESSION_PATH=./data/user.session

# Vercel
PUBLIC_URL=https://your-app.vercel.app
CRON_SECRET=
WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=

# Days after monthly poll publish before winner becomes channel avatar (default 5)
AVATAR_POLL_DELAY_DAYS=5

# Sunday archive caption (Gemini free tier). Backup key is used on any error with the main one.
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# ARCHIVE_HOUR=10
